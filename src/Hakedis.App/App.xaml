<Application x:Class="Hakedis.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hakedis.App"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary/>
                <ResourceDictionary Source="Themes/Oehs.xaml"/>
                <ResourceDictionary Source="Themes/Workspace.xaml"/>
                <ResourceDictionary Source="Themes/PaymentCards.xaml"/>
                <ResourceDictionary Source="Themes/Vault.xaml"/>
                <ResourceDictionary Source="Themes/FluentConcept.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
