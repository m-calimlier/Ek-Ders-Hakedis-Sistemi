<UserControl x:Class="Hakedis.App.SearchableOccupation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <ToggleButton x:Name="Picker" Height="35" Background="{StaticResource NightInputBrush}" Foreground="{StaticResource NightTextBrush}" BorderBrush="#5A7B94" FontSize="11.5" Template="{StaticResource FieldDropToggleTemplate}" ToolTip="Meslek kodu seçin" AutomationProperties.Name="Meslek kodu seçin">
   <TextBlock x:Name="SelectedText" Text="Meslek kodu seçin" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
  </ToggleButton>
  <Popup x:Name="DropDown" IsOpen="{Binding IsChecked, ElementName=Picker}" PlacementTarget="{Binding ElementName=Picker}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Opened="Popup_Opened">
   <Border Background="#09283F" BorderBrush="#5A7B94" BorderThickness="1" CornerRadius="6" Padding="10" Width="620" MaxWidth="700">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="320"/></Grid.RowDefinitions>
     <TextBox x:Name="Search" Style="{StaticResource FormText}" TextChanged="Search_Changed" ToolTip="Kod veya meslek adını yazın" AutomationProperties.Name="Meslek kodu veya adı ara" Margin="0"/>
     <TextBlock x:Name="Count" Grid.Row="1" Foreground="#B9CDDF" Margin="0,6"/>
     <ListBox x:Name="Options" Grid.Row="2" DisplayMemberPath="Display" Background="{StaticResource NightTableBrush}" Foreground="#F0F6FC" BorderThickness="0" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" PreviewMouseLeftButtonUp="Option_Click" PreviewKeyDown="Option_KeyDown"/>
    </Grid>
   </Border>
  </Popup>
 </Grid>
</UserControl>
