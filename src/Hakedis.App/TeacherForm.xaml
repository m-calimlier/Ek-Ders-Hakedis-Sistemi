<UserControl x:Class="Hakedis.App.TeacherForm" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Hakedis.App" xmlns:c="clr-namespace:Hakedis.Contracts;assembly=Hakedis.Contracts"><StackPanel><Grid Margin="0,0,10,8">
 <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <StackPanel><TextBlock Text="Ad" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" AutomationProperties.Name="Ad" Text="{Binding Editor.GivenName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
 <StackPanel Grid.Column="2"><TextBlock Text="Soyad" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource FormText}" AutomationProperties.Name="Soyad" Text="{Binding Editor.FamilyName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
</Grid>
<TextBlock Text="{Binding Editor.LegacyName, StringFormat='Kayıtlı ad soyad: {0}'}" TextWrapping="Wrap" Margin="0,0,10,10">
 <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CardSubtitle}"><Style.Triggers><DataTrigger Binding="{Binding Editor.LegacyName}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
</TextBlock><StackPanel Margin="0,0,10,14"><TextBlock Text="{x:Static c:ExcelHeadings.IdentityNumber}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/><TextBox Style="{StaticResource FormText}" Text="{Binding Editor.IdentityNumber, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,10,14"><TextBlock Text="{x:Static c:ExcelHeadings.Iban}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/><TextBox Style="{StaticResource FormText}" Text="{Binding Editor.Iban, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,10,14"><TextBlock Text="{x:Static c:ExcelHeadings.School}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/><TextBox Style="{StaticResource FormText}" Text="{Binding Editor.School, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,10,14"><TextBlock Text="{x:Static c:ExcelHeadings.Occupation}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/><local:SearchableOccupation Code="{Binding Editor.OccupationCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/></StackPanel><Grid Margin="0,0,10,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="{x:Static c:ExcelHeadings.StartDate}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/><DatePicker Style="{StaticResource FormDate}" SelectedDate="{Binding Editor.StartDate, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="{x:Static c:ExcelHeadings.EndDate}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/><DatePicker Style="{StaticResource FormDate}" SelectedDate="{Binding Editor.EndDate, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
<Expander Header="Kayıtlı okul/modül geçmişi" Foreground="White" Margin="0,6,10,16" Visibility="{Binding Editor.HasAssignmentHistory,Converter={StaticResource Visible}}"><StackPanel>
<TextBlock Text="{Binding Editor.HistoryText}" Style="{StaticResource CardSubtitle}" TextWrapping="Wrap" Margin="0,10,0,12"/>
<Button Content="Son geçişi düzenle" Command="{Binding Editor.EditLastTransferCommand}" Style="{StaticResource SecondaryAction}" HorizontalAlignment="Left"/>
</StackPanel></Expander>
<CheckBox x:Name="SchoolTransferCheck" Content="Okul/modül değişikliği bilgisi ekle" IsChecked="{Binding Editor.HasSchoolTransfer,Mode=TwoWay}" Foreground="White" Margin="0,4,10,14"/>
<Border x:Name="SchoolTransferFields" Visibility="{Binding Editor.HasSchoolTransfer,Converter={StaticResource Visible}}" Background="#082744" BorderBrush="#73581E" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,16"><StackPanel>
<TextBlock Text="{Binding Editor.TransferModeText}" Foreground="#E8C778" FontWeight="SemiBold" Margin="0,0,0,14"/>
<TextBlock Text="Geçiş yapılan okul" Style="{StaticResource FieldLabel}"/>
<TextBox x:Name="TransferSchoolText" Style="{StaticResource FormText}" Text="{Binding Editor.TransferSchool,UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/>
<TextBlock Text="Geçiş yapılan okulda başlama tarihi" Style="{StaticResource FieldLabel}"/>
<DatePicker x:Name="TransferDatePicker" Style="{StaticResource FormDate}" SelectedDate="{Binding Editor.TransferDate,UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12"/>
<TextBlock Text="Geçilen okulun modülü" Style="{StaticResource FieldLabel}"/>
<ComboBox x:Name="TransferModuleCombo" Style="{StaticResource FormCombo}" ItemsSource="{Binding Editor.TransferModules}" SelectedValue="{Binding Editor.TransferModule,Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="Name"/>
<TextBlock Text="Bu bilgiler görev geçmişi içindir. SGK işe giriş/çıkış tarihleri değişmez. Geçiş ayında tek ödeme modülü hakediş oluşturulurken seçilir." Style="{StaticResource CardSubtitle}" TextWrapping="Wrap" Margin="0,12,0,10"/>
<Button Content="Yeni geçiş bilgisi gir" Command="{Binding Editor.NewTransferCommand}" Visibility="{Binding Editor.HasAssignmentHistory,Converter={StaticResource Visible}}" Style="{StaticResource SecondaryAction}" HorizontalAlignment="Left"/>
</StackPanel></Border>
</StackPanel></UserControl>
